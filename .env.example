# ── Entorno ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8018
PUBLIC_APP_URL=https://tu-dominio.com
FRONTEND_ORIGIN=https://tu-dominio.com

# ── Autenticación (Cloudflare Access) ─────────────────────────────────────────
# Poner en false en producción; solo true para desarrollo local
ALLOW_DEV_AUTH=false
CF_ACCESS_TEAM_DOMAIN=tu-equipo.cloudflareaccess.com
CF_ACCESS_AUDIENCE=tu-audience-id

# ── Roles / correos autorizados (separados por coma) ──────────────────────────
ADMIN_EMAILS=admin@ejemplo.com
APPROVER_EMAILS=aprobador@ejemplo.com
REQUESTER_EMAILS=solicitante@ejemplo.com

# ── Base de datos SQL Server ───────────────────────────────────────────────────
DRIVER=ODBC Driver 18 for SQL Server
DB_HOST=ip-o-hostname-del-servidor-sql
DB_PORT=1433
DB_NAME=nombre_base_de_datos
DB_USER=usuario_sql
DB_PASS=contraseña_sql
ENCRYPT=yes
TRUST_CERTIFICATE=no

# ── Token de decisiones ────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
DECISION_TOKEN_SECRET=cambia-esto-por-un-valor-seguro
DECISION_TOKEN_TTL_MINUTES=4320

# ── Correo (graph = Microsoft Graph, console = solo imprime en logs) ───────────
MAIL_PROVIDER=graph
GRAPH_TENANT_ID=tu-tenant-id
GRAPH_CLIENT_ID=tu-client-id
GRAPH_CLIENT_SECRET=tu-client-secret
GRAPH_FROM_EMAIL=no-reply@ejemplo.com
